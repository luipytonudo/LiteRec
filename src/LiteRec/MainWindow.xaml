<Window x:Class="LiteRec.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiteRec" Width="800" Icon="Assets/LiteRec.ico" SizeToContent="Height"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#1F222C" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Barra de título ===== -->
            <Grid Grid.Row="0" Margin="18,0,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="LiteRec" FontSize="14" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Border Background="#1E2130" CornerRadius="6" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="EncoderBadge" Text="GPU · H.264" FontSize="10.5" FontWeight="SemiBold" Foreground="#A99BFF"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimizar"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Cerrar"/>
                </StackPanel>
            </Grid>

            <!-- ===== Contenido ===== -->
            <Grid Grid.Row="1" Margin="18,4,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Columna izquierda -->
                <StackPanel Grid.Column="0">
                    <!-- Panel principal -->
                    <Border Style="{StaticResource CardBorder}" Padding="20,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1B1724" Offset="0"/>
                                <GradientStop Color="#14161D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <Border x:Name="StatusPill" HorizontalAlignment="Center" CornerRadius="20" Padding="12,4" Background="#1A2D24">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Ok}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatusText" Text="LISTO" FontSize="11" FontWeight="Bold" Margin="7,0,0,0"
                                               Foreground="{StaticResource Ok}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="TimerText" Text="00:00:00" FontFamily="{StaticResource MonoFont}" FontSize="46"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                            <TextBlock x:Name="SummaryText" Text="1280×720 · 60 fps · 8 Mbps" FontSize="12"
                                       Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>

                            <!-- Estadísticas -->
                            <Grid Margin="0,16,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock x:Name="FpsStat" Text="—" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="FPS" FontSize="10" Foreground="{StaticResource Dim}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock x:Name="SizeStat" Text="—" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="ARCHIVO" FontSize="10" Foreground="{StaticResource Dim}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock x:Name="CpuStat" Text="—" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="CPU" FontSize="10" Foreground="{StaticResource Dim}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <TextBlock x:Name="RamStat" Text="—" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="RAM" FontSize="10" Foreground="{StaticResource Dim}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Controles -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="FolderButton" Style="{StaticResource RoundButton}" Content="&#xE8B7;"
                                        Click="OpenFolder_Click" ToolTip="Abrir carpeta de grabaciones" VerticalAlignment="Center"/>
                                <Button x:Name="RecordButton" Style="{StaticResource RecordButton}" Margin="26,0"
                                        Click="Record_Click" ToolTip="Grabar / Detener (F9)">
                                    <Grid>
                                        <Ellipse x:Name="RecIconCircle" Width="26" Height="26" Fill="White"/>
                                        <Rectangle x:Name="RecIconStop" Width="24" Height="24" RadiusX="5" RadiusY="5"
                                                   Fill="White" Visibility="Collapsed"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="PauseButton" Style="{StaticResource RoundButton}" Content="&#xE769;"
                                        Click="Pause_Click" ToolTip="Pausar / Reanudar (F10)" IsEnabled="False" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Fuente -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="FUENTE DE CAPTURA" Style="{StaticResource SectionLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SourceCombo" Style="{StaticResource DarkCombo}"/>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Height="38" Width="38" Padding="0"
                                        Click="Refresh_Click" ToolTip="Actualizar lista">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Columna derecha -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel x:Name="VideoPanel">
                            <TextBlock Text="RESOLUCIÓN DE SALIDA" Style="{StaticResource SectionLabel}"/>
                            <Border Style="{StaticResource SegmentHost}">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="Res720" GroupName="res" Style="{StaticResource Segment}" Content="720p" Checked="Option_Changed"/>
                                    <RadioButton x:Name="Res900" GroupName="res" Style="{StaticResource Segment}" Content="900p" Checked="Option_Changed"/>
                                    <RadioButton x:Name="Res1080" GroupName="res" Style="{StaticResource Segment}" Content="1080p" Checked="Option_Changed"/>
                                    <RadioButton x:Name="ResNative" GroupName="res" Style="{StaticResource Segment}" Content="Nativa" Checked="Option_Changed"/>
                                </UniformGrid>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="FOTOGRAMAS" Style="{StaticResource SectionLabel}"/>
                                    <Border Style="{StaticResource SegmentHost}">
                                        <UniformGrid Rows="1">
                                            <RadioButton x:Name="Fps60" GroupName="fps" Style="{StaticResource Segment}" Content="60 fps" Checked="Option_Changed"/>
                                            <RadioButton x:Name="Fps30" GroupName="fps" Style="{StaticResource Segment}" Content="30 fps" Checked="Option_Changed"/>
                                        </UniformGrid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="CÓDEC (GPU)" Style="{StaticResource SectionLabel}"/>
                                    <Border Style="{StaticResource SegmentHost}">
                                        <UniformGrid Rows="1">
                                            <RadioButton x:Name="CodecH264" GroupName="codec" Style="{StaticResource Segment}" Content="H.264" Checked="Option_Changed"
                                                         ToolTip="Máxima compatibilidad (recomendado)"/>
                                            <RadioButton x:Name="CodecH265" GroupName="codec" Style="{StaticResource Segment}" Content="H.265" Checked="Option_Changed"
                                                         ToolTip="Archivos más pequeños (requiere GPU compatible)"/>
                                        </UniformGrid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="CALIDAD" Style="{StaticResource SectionLabel}" Margin="0,14,0,7"/>
                            <Border Style="{StaticResource SegmentHost}">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="QLow" GroupName="q" Style="{StaticResource Segment}" Content="Ligera" Checked="Option_Changed"/>
                                    <RadioButton x:Name="QMid" GroupName="q" Style="{StaticResource Segment}" Content="Equilibrada" Checked="Option_Changed"/>
                                    <RadioButton x:Name="QHigh" GroupName="q" Style="{StaticResource Segment}" Content="Alta" Checked="Option_Changed"/>
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0" Padding="16,11">
                        <StackPanel x:Name="OptionsPanel">
                            <TextBlock Text="AUDIO Y OPCIONES" Style="{StaticResource SectionLabel}" Margin="0,4,0,3"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <CheckBox x:Name="SysAudioToggle" Style="{StaticResource Toggle}" Content="Audio del sistema" Click="Option_Changed"/>
                                    <CheckBox x:Name="MicToggle" Style="{StaticResource Toggle}" Content="Micrófono" Click="Option_Changed"/>
                                    <CheckBox x:Name="CursorToggle" Style="{StaticResource Toggle}" Content="Mostrar cursor" Click="Option_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <CheckBox x:Name="ClicksToggle" Style="{StaticResource Toggle}" Content="Resaltar clics" Click="Option_Changed"/>
                                    <CheckBox x:Name="HideToggle" Style="{StaticResource Toggle}" Content="Ocultar LiteRec" Click="Option_Changed"
                                              ToolTip="La ventana de LiteRec no sale en el video"/>
                                    <CheckBox x:Name="MinimizeToggle" Style="{StaticResource Toggle}" Content="Minimizar al grabar" Click="Option_Changed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent2}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="Guardar en" FontSize="10.5" Foreground="{StaticResource Dim}"/>
                                <TextBlock x:Name="FolderText" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button x:Name="ChangeFolderButton" Grid.Column="2" Style="{StaticResource GhostButton}" Content="Cambiar" Click="ChangeFolder_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== Pie ===== -->
            <Grid Grid.Row="2" Margin="18,12,18,14">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#1D2029" CornerRadius="5" Padding="6,1"><TextBlock Text="F9" FontSize="11" FontWeight="Bold"/></Border>
                    <TextBlock Text="Grabar / Detener" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="6,0,16,0" VerticalAlignment="Center"/>
                    <Border Background="#1D2029" CornerRadius="5" Padding="6,1"><TextBlock Text="F10" FontSize="11" FontWeight="Bold"/></Border>
                    <TextBlock Text="Pausar / Reanudar" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="FooterText" HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource Dim}"
                           TextTrimming="CharacterEllipsis" MaxWidth="400" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
